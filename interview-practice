:root {
  --navy: #1f3a5f;
  --navy-soft: #e8eef6;
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1d2430;
  --muted: #667085;
  --line: #d9dee6;
  --good: #1f8a4c;
  --good-bg: #e6f4ec;
  --some: #b7791f;
  --some-bg: #fdf3e1;
  --ng: #c0392b;
  --ng-bg: #fbe9e7;
  --radius: 14px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Hiragino Sans", "Noto Sans JP", "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
  -webkit-text-size-adjust: 100%;
}

.hidden { display: none !important; }

/* ---- ヘッダー ---- */
.top {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: var(--navy);
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.brand { font-weight: 800; letter-spacing: 1px; font-size: 14px; background: #fff; color: var(--navy); padding: 2px 6px; border-radius: 6px; }
.title .ja { font-weight: 700; font-size: 17px; line-height: 1.2; }
.title .id { font-size: 12px; opacity: .85; }
.badge { margin-left: auto; font-size: 12px; background: rgba(255,255,255,.15); padding: 4px 8px; border-radius: 999px; white-space: nowrap; }

main { max-width: 560px; margin: 0 auto; padding: 16px; }

/* ---- 共通 ---- */
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px;
  margin-bottom: 16px;
}
h2 { font-size: 17px; margin: 0 0 10px; }
h2 span, .label span { display: block; font-size: 13px; font-weight: 400; color: var(--muted); }
.label { margin: 20px 0 10px; }

.btn {
  display: block;
  width: 100%;
  border: none;
  border-radius: var(--radius);
  padding: 14px 16px;
  font-size: 17px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  min-height: 56px;
  margin-bottom: 12px;
  -webkit-tap-highlight-color: transparent;
}
.btn span { display: block; font-size: 13px; font-weight: 400; opacity: .9; }
.btn:active { transform: scale(.98); }
.btn.big { min-height: 64px; font-size: 19px; }
.btn.primary { background: var(--navy); color: #fff; }
.btn.sub { background: var(--navy-soft); color: var(--navy); }
.btn.link { background: none; color: var(--muted); font-weight: 400; font-size: 15px; text-decoration: underline; min-height: 44px; }
.btn:disabled { opacity: .45; }

.row { display: flex; gap: 10px; }
.row .btn { flex: 1; }

/* ---- スタート ---- */
.howto ol { margin: 0; padding-left: 22px; }
.howto li { margin-bottom: 6px; }
.howto li b { display: block; }
.howto li span { font-size: 13px; color: var(--muted); }
.note { margin: 10px 0 0; padding: 10px; background: var(--navy-soft); border-radius: 10px; font-size: 14px; }
.note span { font-size: 13px; color: var(--muted); }

.choices { display: grid; gap: 10px; }
.choice {
  text-align: left;
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: var(--radius);
  padding: 14px 16px;
  font-family: inherit;
  font-size: 17px;
  min-height: 64px;
  cursor: pointer;
  color: var(--text);
}
.choice b { display: block; }
.choice span { font-size: 13px; color: var(--muted); }
.choice.on { border-color: var(--navy); background: var(--navy-soft); }

.catbox { display: grid; gap: 8px; margin-top: 12px; }
.cat {
  text-align: left;
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: 12px;
  padding: 10px 14px;
  font-family: inherit;
  font-size: 15px;
  min-height: 52px;
  cursor: pointer;
  color: var(--text);
}
.cat small { display: block; color: var(--muted); font-size: 12px; }
.cat.on { border-color: var(--navy); background: var(--navy-soft); }
.cat.on::before { content: "✓ "; color: var(--navy); font-weight: 700; }

.seg { display: flex; gap: 10px; margin-bottom: 20px; }
.seg button {
  flex: 1;
  min-height: 56px;
  font-size: 20px;
  font-weight: 700;
  font-family: inherit;
  border: 2px solid var(--line);
  background: var(--card);
  border-radius: 12px;
  color: var(--text);
  cursor: pointer;
}
.seg button.on { border-color: var(--navy); background: var(--navy); color: #fff; }

.history .hitem { display: flex; justify-content: space-between; gap: 8px; padding: 8px 0; border-top: 1px solid var(--line); font-size: 14px; }
.history .hitem:first-child { border-top: none; }
.history .hdate { color: var(--muted); }
.history .empty { color: var(--muted); font-size: 14px; margin: 0; }

/* ---- 練習 ---- */
.progress { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.bar { flex: 1; height: 10px; background: var(--line); border-radius: 999px; overflow: hidden; }
#progressFill { height: 100%; width: 0; background: var(--navy); transition: width .3s; }
.ptext { font-weight: 700; font-size: 15px; min-width: 52px; text-align: right; }

.qcard { padding: 20px 16px; }
.qcat { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
.qcat .star { color: #c58a00; font-weight: 700; }
.qtext { font-size: 24px; font-weight: 700; line-height: 1.6; word-break: break-all; }
.qtrans { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); color: var(--navy); font-size: 16px; }
.timer { margin-top: 14px; font-size: 13px; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
.timer b { font-size: 18px; color: var(--text); font-variant-numeric: tabular-nums; }

.hint ul, .follow ul { margin: 0; padding-left: 20px; }
.hint li, .follow li { margin-bottom: 8px; }
.hint li span, .follow li span { display: block; font-size: 13px; color: var(--muted); }
.follow { background: #fffaf0; border-color: #f0d9a8; }

.rate { display: grid; gap: 10px; }
.rate .btn { margin-bottom: 0; min-height: 64px; }
.rate-good { background: var(--good-bg); color: var(--good); border: 2px solid var(--good) !important; }
.rate-some { background: var(--some-bg); color: var(--some); border: 2px solid var(--some) !important; }
.rate-ng { background: var(--ng-bg); color: var(--ng); border: 2px solid var(--ng) !important; }
#afterBox { margin-bottom: 12px; }

/* ---- 結果 ---- */
.result { text-align: center; }
.score-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 12px 0; }
.score-grid div { border-radius: 12px; padding: 10px 4px; }
.score-grid b { display: block; font-size: 30px; }
.score-grid span { font-size: 13px; }
.score-grid .good { background: var(--good-bg); color: var(--good); }
.score-grid .some { background: var(--some-bg); color: var(--some); }
.score-grid .ng { background: var(--ng-bg); color: var(--ng); }
.rmsg { margin: 0; font-size: 15px; }
.rmsg span { display: block; color: var(--muted); font-size: 13px; }

.review h3 { font-size: 15px; margin: 0 0 8px; }
.review .ritem { padding: 8px 0; border-top: 1px solid var(--line); }
.review .ritem:first-of-type { border-top: none; }
.review .ritem b { font-size: 15px; }
.review .ritem span { display: block; font-size: 13px; color: var(--muted); }
.review .mark { display: inline-block; width: 22px; font-weight: 700; }
.review .mark.some { color: var(--some); }
.review .mark.ng { color: var(--ng); }

footer { text-align: center; font-size: 12px; color: var(--muted); padding: 20px 16px 32px; }
